generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["relationJoins"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================
// ENUMS
// ==========================

enum Role {
  SUPER_ADMIN
  TEACHER
  STUDENT
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

enum ExamStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

enum QuestionType {
  MULTIPLE_CHOICE
  ESSAY
  CODE
}

enum SubmissionStatus {
  IN_PROGRESS
  SUBMITTED
  GRADING
  GRADED
}

enum AssignmentStatus {
  DRAFT
  PUBLISHED
  CLOSED
}

// ==========================
// USER
// ==========================

model User {
  id        String  @id @default(uuid())
  username  String  @unique
  password  String
  fullName  String  @map("full_name")
  email     String? @unique
  avatarUrl String? @map("avatar_url")
  role      Role
  isActive  Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  // Relations - Teacher side
  classTeachers        ClassTeacher[]         @relation("ClassTeachers")
  createdExams         Exam[]                 @relation("ExamCreator")
  createdAssignments   Assignment[]           @relation("AssignmentCreator")
  gradedSubmissions    Submission[]           @relation("SubmissionGrader")
  gradedAssignmentSubs AssignmentSubmission[] @relation("AssignmentSubGrader")
  createdClassSessions ClassSession[]

  // Relations - Student side
  enrollments    Enrollment[]
  submissions    Submission[]           @relation("SubmissionStudent")
  assignmentSubs AssignmentSubmission[] @relation("AssignmentSubStudent")

  @@map("users")
}

// ==========================
// COURSE (nội dung khóa học)
// ==========================

model Course {
  id           String  @id @default(uuid())
  title        String
  description  String?
  thumbnailUrl String? @map("thumbnail_url")
  isActive     Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  classes   Class[]
  
  @@map("courses")
}

// ==========================
// CLASS (lớp học cụ thể, gắn Course + Teacher)
// ==========================

model Class {
  id       String  @id @default(uuid())
  name     String
  courseId String  @map("course_id")
  course   Course  @relation(fields: [courseId], references: [id])
  isActive Boolean @default(true) @map("is_active")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  teachers    ClassTeacher[]
  enrollments Enrollment[]
  exams       Exam[]
  assignments Assignment[]
  playlists   Playlist[]

  sessions ClassSession[]

  @@map("classes")
}

model ClassTeacher {
  id        String  @id @default(uuid())
  classId   String  @map("class_id")
  class     Class   @relation(fields: [classId], references: [id])
  teacherId String  @map("teacher_id")
  teacher   User    @relation("ClassTeachers", fields: [teacherId], references: [id])
  isPrimary Boolean @default(false) @map("is_primary")

  createdAt DateTime @default(now()) @map("created_at")

  @@unique([classId, teacherId])
  @@map("class_teachers")
}

// ==========================
// ENROLLMENT (Student <-> Class)
// ==========================

model Enrollment {
  id        String           @id @default(uuid())
  studentId String           @map("student_id")
  student   User             @relation(fields: [studentId], references: [id])
  classId   String           @map("class_id")
  class     Class            @relation(fields: [classId], references: [id])
  status    EnrollmentStatus @default(ACTIVE)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([studentId, classId])
  @@map("enrollments")
}

// ==========================
// PLAYLIST & VIDEO
// ==========================

model Playlist {
  id      String @id @default(uuid())
  title   String
  classId String @map("class_id")
  class   Class  @relation(fields: [classId], references: [id])
  order   Int    @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  videos   PlaylistVideo[]
  @@map("playlists")
}

model PlaylistVideo {
  id         String   @id @default(uuid())
  title      String
  videoUrl   String   @map("video_url")
  duration   Int? // seconds
  order      Int      @default(0)
  playlistId String   @map("playlist_id")
  playlist   Playlist @relation(fields: [playlistId], references: [id])

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("playlist_videos")
}

// ==========================
// EXAM & QUESTION
// ==========================

model Exam {
  id              String     @id @default(uuid())
  title           String
  description     String?
  classId         String     @map("class_id")
  class           Class      @relation(fields: [classId], references: [id])
  creatorId       String     @map("creator_id")
  creator         User       @relation("ExamCreator", fields: [creatorId], references: [id])
  status          ExamStatus @default(DRAFT)
  durationMinutes Int        @map("duration_minutes")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  questions   Question[]
  submissions Submission[]

  @@map("exams")
}

model Question {
  id            String       @id @default(uuid())
  examId        String       @map("exam_id")
  exam          Exam         @relation(fields: [examId], references: [id])
  type          QuestionType
  content       String
  options       Json? // cho multiple choice: [{key, text}]
  correctAnswer String?      @map("correct_answer")
  score         Float        @default(1)
  order         Int          @default(0)

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("questions")
}

// ==========================
// SUBMISSION (bài thi)
// ==========================

model Submission {
  id            String           @id @default(uuid())
  examId        String           @map("exam_id")
  exam          Exam             @relation(fields: [examId], references: [id])
  studentId     String           @map("student_id")
  student       User             @relation("SubmissionStudent", fields: [studentId], references: [id])
  attemptNumber Int              @default(1) @map("attempt_number")
  shuffleConfig Json?            @map("shuffle_config")
  answers       Json?
  autoScore     Float?           @map("auto_score")
  manualScore   Float?           @map("manual_score")
  score         Float?
  status        SubmissionStatus @default(IN_PROGRESS)
  gradedById    String?          @map("graded_by_id")
  gradedBy      User?            @relation("SubmissionGrader", fields: [gradedById], references: [id])
  startedAt     DateTime?        @map("started_at")
  submittedAt   DateTime?        @map("submitted_at")
  gradedAt      DateTime?        @map("graded_at")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([examId, studentId, attemptNumber])
  @@map("submissions")
}

// ==========================
// ASSIGNMENT (bài tập thực hành) - MỚI
// ==========================

model Assignment {
  id          String           @id @default(uuid())
  title       String
  description String?
  classId     String           @map("class_id")
  class       Class            @relation(fields: [classId], references: [id])
  creatorId   String           @map("creator_id")
  creator     User             @relation("AssignmentCreator", fields: [creatorId], references: [id])
  status      AssignmentStatus @default(DRAFT)
  dueDate     DateTime?        @map("due_date")

  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  deletedAt DateTime? @map("deleted_at")

  submissions AssignmentSubmission[]

  @@map("assignments")
}

// ==========================
// ASSIGNMENT SUBMISSION - MỚI
// ==========================

model AssignmentSubmission {
  id           String     @id @default(uuid())
  assignmentId String     @map("assignment_id")
  assignment   Assignment @relation(fields: [assignmentId], references: [id])
  studentId    String     @map("student_id")
  student      User       @relation("AssignmentSubStudent", fields: [studentId], references: [id])
  fileUrl      String     @map("file_url") // Cloudinary URL
  fileName     String?    @map("file_name")
  note         String?
  isLate       Boolean    @default(false) @map("is_late")
  score        Float?
  feedback     String?
  gradedById   String?    @map("graded_by_id")
  gradedBy     User?      @relation("AssignmentSubGrader", fields: [gradedById], references: [id])

  submittedAt DateTime  @default(now()) @map("submitted_at")
  gradedAt    DateTime? @map("graded_at")

  @@unique([assignmentId, studentId])
  @@map("assignment_submissions")
}

model ClassSession {
  id          String    @id @default(uuid())
  classId     String    @map("class_id")
  class       Class     @relation(fields: [classId], references: [id])
  title       String?   // Nội dung buổi học, có thể để trống rồi cập nhật sau
  startAt     DateTime  @map("start_at")
  endAt       DateTime  @map("end_at")
  isMakeup    Boolean   @default(false) @map("is_makeup") // Buổi học bù
  scheduleGroupId String? @map("schedule_group_id") // Đánh dấu các buổi cùng sinh ra từ 1 lần tạo lịch lặp (để sau này có thể sửa/xóa hàng loạt nếu cần)
  createdById String    @map("created_by_id")
  createdBy   User      @relation(fields: [createdById], references: [id])

  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  @@map("class_sessions")
}
